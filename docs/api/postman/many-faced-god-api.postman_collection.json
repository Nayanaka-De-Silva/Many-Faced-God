									"    pm.expect(npc.senses).to.have.property('raw').that.is.an('array');",
									"    pm.expect(npc.senses).to.have.property('formatted').that.is.an('array');",
									"});",
									"",
									"pm.test('spellcasting is an array, never null', function () {",
									"    pm.expect(npc.spellcasting).to.be.an('array');",
									"});",
									"",
									"pm.test('Arena gets usable HP', function () {",
