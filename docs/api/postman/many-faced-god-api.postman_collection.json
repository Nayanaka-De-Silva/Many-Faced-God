									"    pm.expect(Object.keys(body.challengeRatings)).to.have.lengthOf(34);",
									"});",
									"",
									"pm.test('CR to XP values match the DMG', function () {",
									"    const cr = body.challengeRatings;",
									"    const xp = (k) => (typeof cr[k] === 'object' ? cr[k].xp : cr[k]);",
									"    pm.expect(xp('1/8')).to.eql(25);",
									"    pm.expect(xp('1/4')).to.eql(50);",
									"    pm.expect(xp('1/2')).to.eql(100);",
									"    pm.expect(xp('1')).to.eql(200);",
									"    pm.expect(xp('3')).to.eql(700);",
									"    pm.expect(xp('20')).to.eql(25000);",
									"    pm.expect(xp('30')).to.eql(155000);",
									"});",
									"",
									"pm.test('Action types keep their snake_case enum values', function () {",
									"    const types = JSON.stringify(body.actionTypes);",
									"    pm.expect(types).to.include('attack_action');",
									"    pm.expect(types).to.include('legendary_action');",
									"});"
