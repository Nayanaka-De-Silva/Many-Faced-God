							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"const npc = body.data;",
									"",
									"pm.collectionVariables.set('npcEtag', pm.response.headers.get('ETag') || '');",
									"pm.collectionVariables.set('npcBody', pm.response.text());",
									"",
									"pm.test('Single resource is wrapped in data', function () {",
									"    pm.expect(body).to.have.property('data').that.is.an('object');",
									"});",
									"",
									"pm.test('Serves an ETag for offline revalidation', function () {",
									"    pm.expect(pm.response.headers.get('ETag')).to.be.a('string').and.not.empty;",
									"});",
									"",
									"pm.test('ETag is readable cross-origin', function () {",
									"    const exposed = pm.response.headers.get('Access-Control-Expose-Headers') || '';",
									"    pm.expect(exposed.toLowerCase(),",
									"        'ETag not exposed \u2014 browser JS cannot read it').to.include('etag');",
