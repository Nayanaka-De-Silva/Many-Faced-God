		{
			"name": "NPCs",
			"item": [
				{
					"name": "List NPCs (seeds npcId / folderId)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/npcs",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"npcs"
							]
						},
						"description": "Default listing. Captures a real npcId and folderId into collection variables for every later request, so the collection runs end-to-end without manual setup."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK', () => pm.response.to.have.status(200));",
									"const body = pm.response.json();",
									"",
									"pm.test('Uses the data/meta envelope', function () {",
									"    pm.expect(body).to.have.property('data').that.is.an('array');",
									"    pm.expect(body).to.have.property('meta').that.is.an('object');",
									"});",
									"",
									"pm.test('Meta is camelCase and complete', function () {",
									"    ['page', 'pageSize', 'totalItems', 'totalPages'].forEach(function (k) {",
									"        pm.expect(body.meta, 'missing meta.' + k).to.have.property(k);",
									"    });",
									"    // Laravel's default paginator envelope would leak these.",
									"    ['per_page', 'current_page', 'total', 'links'].forEach(function (k) {",
									"        pm.expect(body.meta, 'snake_case leak: ' + k).to.not.have.property(k);",
									"    });",
									"});",
									"",
									"pm.test('Defaults to pageSize 25', function () {",
									"    pm.expect(body.meta.pageSize).to.eql(25);",
									"});",
									"",
									"if (body.data.length === 0) {",
									"    console.warn('No NPCs returned \u2014 seed the database or later requests will be skipped.');",
									"} else {",
									"    const npc = body.data[0];",
									"    pm.environment.set('npcId', npc.id);",
									"    if (npc.folder && npc.folder.id) {",
									"        pm.environment.set('folderId', npc.folder.id);",
									"    }",
									"",
									"    pm.test('List items are full statblocks, not summaries', function () {",
									"        ['abilities', 'traits', 'actions', 'spellcasting',",
									"         'passivePerception', 'challengeRating']",
									"            .forEach(function (k) {",
									"                pm.expect(npc, 'statblock missing ' + k).to.have.property(k);",
									"            });",
									"    });",
									"",
									"    pm.test('No template leaks into /npcs', function () {",
									"        body.data.forEach(function (n) {",
									"            pm.expect(n.isTemplate, 'template ' + n.id + ' leaked').to.eql(false);",
									"        });",
									"    });",
									"",
									"    pm.test('challengeRating is always an object, never a bare null', function () {",
									"        body.data.forEach(function (n) {",
									"            pm.expect(n.challengeRating).to.be.an('object').and.to.not.be.null;",
									"            pm.expect(n.challengeRating).to.have.property('value');",
									"            pm.expect(n.challengeRating).to.have.property('xp');",
									"            pm.expect(n.challengeRating).to.have.property('xpIfDangerous');",
									"        });",
									"    });",
									"",
									"    pm.test('A null CR never resolves to 0 XP', function () {",
									"        body.data.forEach(function (n) {",
									"            if (n.challengeRating.value === null) {",
									"                pm.expect(n.challengeRating.xp,",
									"                    'NPC ' + n.id + ' coerced a null CR to a number').to.be.null;",
									"            }",
									"        });",
									"    });",
									"",
									"    pm.test('Keys are camelCase, not snake_case', function () {",
									"        Object.keys(npc).forEach(function (k) {",
									"            pm.expect(k, 'snake_case key: ' + k).to.not.match(/_/);",
									"        });",
									"    });",
									"",
									"    pm.test('sourceRef is namespaced for Arena', function () {",
									"        pm.expect(npc.sourceRef).to.eql('mfg:npc:' + npc.id);",
									"    });",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "List NPCs - pageSize is clamped, not rejected",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/npcs?pageSize=500",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"npcs"
							],
							"query": [
								{
									"key": "pageSize",
									"value": "500"
								}
							]
						},
						"description": "Full statblocks are a ~10x payload multiplier, so pageSize caps at 50. An over-large request is clamped and the real value echoed back in meta, rather than erroring."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 OK (clamped, not rejected)', () => pm.response.to.have.status(200));",
									"const meta = pm.response.json().meta;",
									"",
									"pm.test('pageSize clamped to 50', function () {",
									"    pm.expect(meta.pageSize).to.eql(50);",
									"});",
									"",
									"pm.test('meta reports the value actually applied', function () {",
									"    pm.expect(pm.response.json().data.length).to.be.at.most(meta.pageSize);",
									"});"
								]
							}
						}
					]
				},
