									"const body = pm.response.json();",
									"",
									"pm.test('Advertises version 1', function () {",
									"    pm.expect(String(body.version)).to.eql('1');",
									"});",
									"",
									"pm.test('Links to the OpenAPI contract', function () {",
									"    pm.expect(body.openapi).to.be.a('string').and.to.include('openapi.yaml');",
									"});",
									"",
									"pm.test('Lists its endpoints', function () {",
									"    pm.expect(body.endpoints).to.be.an('object');",
									"    const keys = Object.keys(body.endpoints).join(' ');",
									"    ['npcs', 'templates', 'folders'].forEach(function (k) {",
									"        pm.expect(keys).to.include(k);",
									"    });",
									"});"
								]
							}
						}
					]
				},
